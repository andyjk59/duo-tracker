rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Anonymous sign-in is required (handled transparently by the app),
    // which keeps this off-limits to random web crawlers hitting the
    // REST API directly, while staying simple for the two people using it.
    // Both people share full read/write access to all data — there's no
    // per-user access control, since the whole point is mutual visibility.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
